# Copy to .env and fill in. Values are used ONLY on first boot, when
# data/config.json does not exist yet. After that, edit in the dashboard.

# --- ntfy delivery ---
# Use https://ntfy.sh, or an address reachable from the container
# (e.g. http://ntfy:80 on a shared Docker network).
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
NTFY_DRY_RUN=true
# 0 = per-alert default, 3 = normal, 4 = high, 5 = urgent (lock-screen)
NTFY_MIN_PRIORITY=0

# --- location (find coordinates with the dashboard search) ---
WEATHER_LOCATION_NAME=Pune, Maharashtra, India
WEATHER_LAT=18.5204
WEATHER_LON=73.8567
WEATHER_NAME=there

# --- rules ---
WEATHER_INTERVAL_MINUTES=5
WEATHER_COOLDOWN_HOURS=24
WEATHER_RAIN_THRESHOLD=80

# --- optional dashboard protection (HTTP basic auth) ---
# Leave empty for local-only use. Set both to require a login.
DASHBOARD_USER=
DASHBOARD_PASS=
